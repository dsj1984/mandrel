{
  "$schema": "./.agents/schemas/agentrc.schema.json",
  "project": {
    "paths": {
      "agentRoot": ".agents",
      "docsRoot": "docs",
      "tempRoot": "temp"
    },
    "commands": {
      "typecheck": "node --version"
    }
  },
  "github": {
    "owner": "dsj1984",
    "repo": "mandrel",
    "projectNumber": 1,
    "operatorHandle": "@[USERNAME]",
    "branchProtection": {
      "requiredChecks": [
        { "name": "lint", "cmd": ["npm", "run", "lint"] },
        { "name": "test", "cmd": ["npm", "test"] },
        {
          "name": "baselines",
          "cmd": ["node", ".agents/scripts/check-baselines.js"]
        }
      ]
    }
  },
  "delivery": {
    "docsFreshness": {
      "paths": ["README.md", "docs/CHANGELOG.md"]
    },
    "quality": {
      "gates": {
        "coverage": {
          "floors": { "*": { "lines": 96, "branches": 88, "functions": 89 } }
        },
        "crap": {
          "floors": { "*": { "methodsAbove20": 2 } },
          "targetDirs": [".agents/scripts", "bin", "lib", "scripts"],
          "ignoreGlobs": [
            ".agents/scripts/**/__tests__/**",
            ".agents/scripts/lib/generated/**"
          ]
        },
        "maintainability": {
          "floors": { "*": { "min": 76 } },
          "targetDirs": [".agents/scripts", "bin", "lib", "scripts"],
          "tolerance": { "kind": "absolute", "value": 0.5 },
          "ignoreGlobs": [
            ".agents/scripts/lib/config-settings-schema*.js",
            ".agents/scripts/lib/config/gates/*.schema.js",
            ".agents/scripts/lib/generated/**",
            ".agents/scripts/**/__tests__/**",
            "lib/**/__tests__/**"
          ]
        },
        "duplication": {
          "floors": { "*": { "percentage": 9 } },
          "targetDirs": [".agents/scripts", "bin", "lib", "scripts"],
          "tolerance": { "kind": "absolute", "value": 1 },
          "ignoreGlobs": [
            ".agents/scripts/**/__tests__/**",
            ".agents/scripts/lib/generated/**",
            "lib/**/__tests__/**"
          ]
        }
      }
    }
  }
}
