    "lib/migrations/index.js!",
    ".agents/scripts/acceptance-eval.js!",
    ".agents/scripts/agents-bootstrap-github.js!",
    ".agents/scripts/apply-quality-bootstrap.js!",
    ".agents/scripts/audit-baselines.js!",
    ".agents/scripts/audit-labels-bootstrap.js!",
    ".agents/scripts/audit-to-stories.js!",
    ".agents/scripts/boot-sweep.js!",
    ".agents/scripts/bootstrap.js!",
    ".agents/scripts/check-arch-cycles.js!",
    ".agents/scripts/check-baselines.js!",
    ".agents/scripts/check-context-budget.js!",
    ".agents/scripts/check-cyclomatic.js!",
    ".agents/scripts/check-dead-exports.js!",
    ".agents/scripts/check-doc-links.js!",
    ".agents/scripts/check-gherkin-corpus.js!",
    ".agents/scripts/check-test-temp-hygiene.js!",
    ".agents/scripts/check-windows-git-perf.js!",
    ".agents/scripts/ceremony-derive.js!",
    ".agents/scripts/coverage-capture.js!",
    ".agents/scripts/deliver-light.js!",
    ".agents/scripts/deliver-recover.js!",
    ".agents/scripts/deliver-run.js!",
    ".agents/scripts/diagnose-friction.js!",
    ".agents/scripts/diagnose.js!",
    ".agents/scripts/drain-pending-cleanup.js!",
    ".agents/scripts/evidence-gate.js!",
    ".agents/scripts/file-ci-gap.js!",
    ".agents/scripts/generate-config-docs.js!",
    ".agents/scripts/generate-lens-checklists.js!",
    ".agents/scripts/generate-skills-index.js!",
    ".agents/scripts/generate-workflows-doc.js!",
    ".agents/scripts/git-cleanup.js!",
    ".agents/scripts/lint-issue-body.js!",
    ".agents/scripts/mandrel-update-preflight.js!",
    ".agents/scripts/merge-baseline.js!",
    ".agents/scripts/nav-registry-diff.js!",
    ".agents/scripts/plan-context.js!",
    ".agents/scripts/plan-critics.js!",
    ".agents/scripts/plan-persist.js!",
    ".agents/scripts/plan-run-epilogue.js!",
    ".agents/scripts/pr-watch-with-update.js!",
    ".agents/scripts/prune-plan-run-labels.js!",
    ".agents/scripts/quality-preview.js!",
    ".agents/scripts/quality-watch.js!",
    ".agents/scripts/resolve-doc-tiers.js!",
    ".agents/scripts/resolve-stories.js!",
    ".agents/scripts/resync-status-column.js!",
    ".agents/scripts/run-tests.js!",
    ".agents/scripts/single-story-close.js!",
    ".agents/scripts/single-story-confirm-merge.js!",
    ".agents/scripts/single-story-init.js!",
    ".agents/scripts/stories-wave-tick.js!",
    ".agents/scripts/sync-agentrc.js!",
    ".agents/scripts/sync-claude-agents.js!",
    ".agents/scripts/sync-claude-commands.js!",
    ".agents/scripts/test-wrapper.js!",
    ".agents/scripts/update-coverage-baseline.js!",
    ".agents/scripts/update-crap-baseline.js!",
    ".agents/scripts/update-duplication-baseline.js!",
    ".agents/scripts/update-maintainability-baseline.js!",
    ".agents/scripts/update-ticket-state.js!",
    ".agents/scripts/validate-skills.js!",
    "scripts/*.js!",
    "tests/**/*.{js,mjs,cjs}",
    ".agents/scripts/**/__tests__/**/*.test.js",
    ".agents/scripts/**/__tests__/fixtures/**/*.js",
    "*.config.{js,mjs,cjs}",
    ".husky/**"
  ],
  "project": [
    "bin/**/*.js!",
    "lib/**/*.js!",
    ".agents/scripts/**/*.js!",
    "scripts/**/*.js!",
    "tests/**/*.{js,mjs,cjs}"
  ],
  "ignore": [
    "node_modules/**",
    ".worktrees/**",
    "coverage/**",
    "temp/**",
    "baselines/**",
    ".claude/**",
    "lib/**/__tests__/**",
    ".agents/scripts/lib/generated/**"
  ],
  "rules": {
    "files": "error",
    "duplicates": "off",
    "dependencies": "error",
    "devDependencies": "error",
    "binaries": "off",
    "unlisted": "off",
    "unresolved": "off",
    "exports": "error",
    "types": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "error"
  }
}
