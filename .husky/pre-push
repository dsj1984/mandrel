#!/usr/bin/env sh
# Pre-push — fast, diff-scoped gates against origin/main (see
# delivery.quality.gateScoping in .agentrc.json). Does NOT run full-repo
# lint, docs:check, or the full test suite.
#
# Before opening a PR or when you want CI-parity confidence locally, run:
#   npm run verify
# That runs audit → lint (biome + docs:check) → npm test → unified
# check-baselines → the standalone ratchets. CI (.github/workflows/ci.yml)
# remains the authoritative full gate on every PR; `.agents/rules/
# known-tooling-behavior.md` entry 2 carries the current coverage table.
#
# Optional: PREPUSH_AUDIT=1 re-enables npm audit (CI still audits on PR/push).

# Drain the pre-push ref protocol from stdin. Nothing below reads it, but an
# unconsumed stdin can leak into the next command on some shells.
cat > /dev/null

node .agents/scripts/quality-preview.js --changed-since origin/main
if [ "${PREPUSH_AUDIT:-0}" = "1" ]; then
  npm audit --audit-level=high
fi

node .agents/scripts/coverage-capture.js --skip-when-no-crap-files --ref origin/main
npm run crap:check

# The two resident-context measurements, both pure-Node and sub-second, so
# they belong on the fast diff-scoped surface. Story #5004 put the first one
# here when it was still a ratchet that reddened on a shrink; Story #5340
# demoted both to reports — `check-context-budget.js` now fails on the
# `alwaysLoaded` tier alone, and `check-workflow-citations.js` never fails.
# They stay because the numbers are worth reading before a push, not because
# they can stop one.
node .agents/scripts/check-context-budget.js
node .agents/scripts/check-workflow-citations.js
